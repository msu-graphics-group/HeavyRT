{
  "mainClass"     : "EyeRayCaster",
  "baseClasses"   : [],
  "composClasses" : [{"interface" : "ISceneObject", 
                      "implementation": "BVH2CommonLoftRT",
                      "intersection": {
                        "shader"   : "IntersectAllPrimitivesInLeaf",
                        "complete" : "IntersectionComplete",
                        "accel"    : "m_pAccelStruct"
                      }}],
  "baseDirectory"  : "..",
  "source"         : ["examples/01_eye_rays/eye_ray.cpp", "core/BVH2CommonLoftRT.cpp"],
  "includeProcess" : [".", "examples", "core", "core/builders"],
  "includeIgnore"  : ["external", "core/common"],
  "additionaIncludes" : ["BVH2CommonLoftRT.h"],
  "options" : {
    "-pattern"    : "rtv",
    "-megakernel" : "1",
    "-shaderCC"   : "slang",
    "-shaderFolderPrefix" : "examples/01_eye_rays/",
    "-timestamps"   : "0",
    "-suffix" : "_GPU_RQ",
    "-const_ubo"  : 1
  },
  "kernels" : {
        "all"        : {"nonConstantData": {"out_color"  : 1}},
        "PackXYMega" : {"nonConstantData": {"m_packedXY" : 1}}
  },
  "defines" : {
    "ENABLE_SPHERES" : ""
  },
  "end" : ""
}