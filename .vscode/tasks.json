{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "BuildRelease",
            "type": "shell",
            "command": "cd cmake-build-release && make -j 8",
            "group": "build"
        },
        {
            "label": "BuildDebug",
            "type": "shell",
            "command": "cd cmake-build-debug && make -j 8",
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },

        {
            "label": "BuildShaders: eye_cs_slang",
            "type": "shell",
            "command": "cd examples/01_eye_rays/shaders_gpu_sw && bash build_slang.sh",
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },

        {
            "label": "BuildShaders: eye_rq_slang",
            "type": "shell",
            "command": "cd examples/01_eye_rays/shaders_gpu_rq && bash build_slang.sh",
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },

        {
            "label": "BuildShaders: rtao_cs_slang",
            "type": "shell",
            "command": "cd examples/02_rtao/shaders_gpu_cs && bash build_slang.sh",
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },

    ]